{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChelseaKR/id-churn-sentinel/blob/main/docs/schema/status-v1.schema.json",
  "title": "ID Churn Sentinel public run status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "state",
    "stale",
    "stale_after_seconds",
    "message",
    "last_attempted_run",
    "last_successful_run"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.1", "1.2"],
      "description": "1.1 (issue #19) adds unmeasured_source_ids, unmeasured_count and observed_source_count to every run, so a retrieval that returned no readable text can no longer be counted among the pages we watched. 1.2 (issue #74) adds the OPTIONAL `availability` block, the HEAD-only probe channel's summary. Earlier versions are still accepted because a document written before a change is republished on the next `sentinel publish`, not by an edit to a generated file."
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "state": {
      "type": "string",
      "enum": ["running", "quiet", "complete", "partial", "failed", "stale"]
    },
    "stale": { "type": "boolean" },
    "stale_after_seconds": { "type": "integer", "minimum": 1 },
    "message": { "type": "string", "minLength": 1 },
    "last_attempted_run": {
      "oneOf": [{ "$ref": "#/$defs/run" }, { "type": "null" }]
    },
    "last_successful_run": {
      "oneOf": [{ "$ref": "#/$defs/run" }, { "type": "null" }]
    },
    "availability": { "$ref": "#/$defs/availability" }
  },
  "$defs": {
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "description": "The HEAD-only availability channel (`sentinel probe`, schema 1.2). ABSENT means that channel has not run — which is NOT the same as, and must never be read as, 'nothing was unavailable'. Probes never read a body, never produce a snapshot, and are never counted as watch observations: a source that probed reachable is not a source that was watched.",
      "required": ["channel", "statement", "last_probe_at", "probes", "sources", "episodes_total", "episodes_measured", "episodes_censored", "episode_length_probes"],
      "properties": {
        "channel": { "type": "string", "const": "head-probe" },
        "statement": { "type": "string", "minLength": 1 },
        "last_probe_at": { "type": "string", "format": "date-time" },
        "probes": { "type": "integer", "minimum": 0 },
        "sources": { "type": "integer", "minimum": 0 },
        "episodes_total": { "type": "integer", "minimum": 0 },
        "episodes_measured": {
          "type": "integer",
          "minimum": 0,
          "description": "Outage episodes whose start AND end this channel observed. Only these have a measured length."
        },
        "episodes_censored": {
          "type": "integer",
          "minimum": 0,
          "description": "Episodes with at least one end unobserved. Their lengths are lower bounds, not measurements, and are excluded from the distribution below."
        },
        "episode_length_probes": { "$ref": "#/$defs/episodeLengths" }
      }
    },
    "episodeLengths": {
      "type": "object",
      "additionalProperties": false,
      "description": "The distribution of measured episode lengths, counted in PROBES rather than hours because the probe cadence is operator configuration and an hours figure would silently rewrite history the day it changed. With no measured episode every figure is null and `reason` says why — never zero, which would read as 'outages lasted no time'.",
      "required": ["n"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "min": { "type": ["integer", "null"], "minimum": 0 },
        "median": { "type": ["number", "null"], "minimum": 0 },
        "max": { "type": ["integer", "null"], "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "counts": { "type": "object" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "state",
        "started_at",
        "completed_at",
        "as_of",
        "scope",
        "registry_version",
        "registry_revision",
        "eligible_source_ids",
        "attempted_source_ids",
        "successful_source_ids",
        "unmeasured_source_ids",
        "eligible_count",
        "attempted_count",
        "successful_retrieval_count",
        "unmeasured_count",
        "observed_source_count",
        "attempt_completeness",
        "observation_count",
        "has_internal_error"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "state": {
          "type": "string",
          "enum": ["running", "quiet", "complete", "partial", "failed"]
        },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": {
          "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
        },
        "as_of": { "type": "string", "format": "date" },
        "scope": { "type": "string", "minLength": 1 },
        "registry_version": { "type": "string", "minLength": 1 },
        "registry_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "eligible_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "attempted_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "successful_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "unmeasured_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "eligible_count": { "type": "integer", "minimum": 0 },
        "attempted_count": { "type": "integer", "minimum": 0 },
        "successful_retrieval_count": { "type": "integer", "minimum": 0 },
        "unmeasured_count": { "type": "integer", "minimum": 0 },
        "observed_source_count": { "type": "integer", "minimum": 0 },
        "attempt_completeness": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "null" }
          ]
        },
        "observation_count": { "type": "integer", "minimum": 0 },
        "has_internal_error": { "type": "boolean" }
      }
    }
  }
}
