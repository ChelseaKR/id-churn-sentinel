{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChelseaKR/id-churn-sentinel/blob/main/docs/schema/registry-overlay-v1.schema.json",
  "title": "ID Churn Sentinel registry overlay v1",
  "description": "An organization's OWN list of sources to watch under this repository's discipline (`--overlay FILE`; see docs/CONSUMERS.md). It has the committed registry's shape plus `overlay_id`, and it is loaded by the committed registry's own validator, which is the authority: any document this schema rejects, the loader rejects too, and the loader also refuses a few things this schema cannot express (credentials in a URL, a verification whose expiry precedes its date, a URL another namespace already watches). Unknown keys are ignored, as the loader ignores them. Nothing in an overlay ever enters the public artifact.",
  "type": "object",
  "required": [
    "registry_version",
    "overlay_id",
    "sources"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "1.0"
    },
    "overlay_id": {
      "type": "string",
      "pattern": "^(?!(?:us|us-ak|us-al|us-ar|us-az|us-ca|us-co|us-ct|us-dc|us-de|us-fl|us-ga|us-hi|us-ia|us-id|us-il|us-in|us-ks|us-ky|us-la|us-ma|us-md|us-me|us-mi|us-mn|us-mo|us-ms|us-mt|us-nc|us-nd|us-ne|us-nh|us-nj|us-nm|us-nv|us-ny|us-oh|us-ok|us-or|us-pa|us-ri|us-sc|us-sd|us-tn|us-tx|us-ut|us-va|us-vt|us-wa|us-wi|us-wv|us-wy)$)[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The namespace every store row this overlay writes is keyed under: a lowercase-hyphen slug, and not the name of a published per-jurisdiction feed (`us`, `us-tx`, …), because an overlay's artifacts are named after it."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "jurisdiction",
        "document_class",
        "url",
        "authority",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "jurisdiction": {
          "type": "string",
          "enum": [
            "AK",
            "AL",
            "AR",
            "AZ",
            "CA",
            "CO",
            "CT",
            "DC",
            "DE",
            "FL",
            "GA",
            "HI",
            "IA",
            "ID",
            "IL",
            "IN",
            "KS",
            "KY",
            "LA",
            "MA",
            "MD",
            "ME",
            "MI",
            "MN",
            "MO",
            "MS",
            "MT",
            "NC",
            "ND",
            "NE",
            "NH",
            "NJ",
            "NM",
            "NV",
            "NY",
            "OH",
            "OK",
            "OR",
            "PA",
            "RI",
            "SC",
            "SD",
            "TN",
            "TX",
            "US",
            "UT",
            "VA",
            "VT",
            "WA",
            "WI",
            "WV",
            "WY"
          ]
        },
        "document_class": {
          "type": "string",
          "enum": [
            "birth_certificate",
            "court_order_name_change",
            "drivers_license",
            "passport",
            "selective_service",
            "social_security"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^[Hh][Tt][Tt][Pp][Ss]://[^#]*#?$",
          "description": "https only, and no #fragment: a fetch cannot honour one."
        },
        "authority": {
          "type": "string",
          "pattern": "\\S"
        },
        "notes": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "checked": {
          "type": "object"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "fetch_policy": {
          "$ref": "#/$defs/fetch_policy"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "verified": {
                "const": true
              }
            },
            "required": [
              "verified"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "verification"
            ],
            "properties": {
              "verification": {
                "type": "object",
                "required": [
                  "status",
                  "verifier",
                  "at"
                ],
                "properties": {
                  "status": {
                    "const": "verified"
                  },
                  "verifier": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "at": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          }
        }
      ],
      "description": "`verified: true` needs a verification naming the human and the date. A verification with no name on it is not a verification."
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "rejected",
            "unverified",
            "verified"
          ]
        },
        "verifier": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "note": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        }
      }
    },
    "fetch_policy": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "unreviewed"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"
        },
        "evidence": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "jurisdiction",
        "document_class",
        "reason",
        "hosts",
        "checked",
        "detail"
      ],
      "properties": {
        "jurisdiction": {
          "type": "string",
          "enum": [
            "AK",
            "AL",
            "AR",
            "AZ",
            "CA",
            "CO",
            "CT",
            "DC",
            "DE",
            "FL",
            "GA",
            "HI",
            "IA",
            "ID",
            "IL",
            "IN",
            "KS",
            "KY",
            "LA",
            "MA",
            "MD",
            "ME",
            "MI",
            "MN",
            "MO",
            "MS",
            "MT",
            "NC",
            "ND",
            "NE",
            "NH",
            "NJ",
            "NM",
            "NV",
            "NY",
            "OH",
            "OK",
            "OR",
            "PA",
            "RI",
            "SC",
            "SD",
            "TN",
            "TX",
            "US",
            "UT",
            "VA",
            "VT",
            "WA",
            "WI",
            "WV",
            "WY"
          ]
        },
        "document_class": {
          "type": "string",
          "enum": [
            "birth_certificate",
            "court_order_name_change",
            "drivers_license",
            "passport",
            "selective_service",
            "social_security"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "blocked-200",
            "blocked-403",
            "blocked-404",
            "false-drift",
            "js-challenge",
            "no-such-authority",
            "robots-disallowed",
            "spa-no-text",
            "tls-unverifiable",
            "unreachable",
            "wrong-page"
          ]
        },
        "hosts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "checked": {
          "type": "string"
        },
        "detail": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
